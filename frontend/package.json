{
  "name": "frontend",
  "private": true,
  "version": "1.25.0-beta.8",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate:bun-nix": "bun2nix -o bun.nix",
    "dev": "vite",
    "build": "bun node_modules/@typescript/native/bin/tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "doctor": "react-doctor . --diff false --no-score --blocking none",
    "doctor:score": "react-doctor . --diff false --blocking none --score",
    "doctor:changed": "react-doctor . --diff origin/main --no-score --blocking none",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc -b",
    "preview": "vite preview",
    "screenshots": "npx playwright test --config screenshots/playwright.config.ts",
    "test:browser-smoke": "playwright test --config browser-smoke/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "bun2nix": "2.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "react-doctor": "^0.9.13",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "typescript": "npm:typescript@~6.0.3",
    "typescript-eslint": "^8.69.0",
    "@playwright/test": "^1.63.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
