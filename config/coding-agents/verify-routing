#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path(os.environ.get("AGENT_LB_USER_HOME", Path.home()))
REPO = Path(__file__).resolve().parents[2]
CANONICAL = HOME / ".agents" / "policy" / "coding-agents" / "ROUTING.md"
MARKER = "<!-- agent-lb:coding-agent-routing:start -->"
failures: list[str] = []


def check(condition: bool, message: str) -> None:
    if condition:
        print(f"PASS {message}")
    else:
        failures.append(message)
        print(f"FAIL {message}")


check(CANONICAL.is_file(), f"canonical policy exists at {CANONICAL}")

claude_doc = HOME / ".claude" / "CLAUDE.md"
claude_text = claude_doc.read_text() if claude_doc.is_file() else ""
check(claude_text.count(MARKER) == 1, f"{claude_doc} has one managed routing block")
check(
    claude_text.count("~/.agents/policy/coding-agents/ROUTING.md") == 1,
    f"{claude_doc} points once to canonical policy",
)

codex_doc = HOME / ".codex" / "AGENTS.md"
codex_text = codex_doc.read_text() if codex_doc.is_file() else ""
check(MARKER not in codex_text, f"{codex_doc} carries no retired managed routing block")

settings_path = HOME / ".claude" / "settings.json"
try:
    settings = json.loads(settings_path.read_text()) if settings_path.is_file() else {}
except json.JSONDecodeError:
    settings = {}
    check(False, f"{settings_path} contains valid JSON")
check(settings.get("model") == "fable", "direct Claude Code default is Fable 5")
check(settings.get("effortLevel") == "high", "direct Claude Code default effort is high")

designer_source = REPO / "config" / "coding-agents" / "agents" / "frontend-designer.md"
designer_path = HOME / ".claude" / "agents" / "frontend-designer.md"
designer_owner_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "frontend-designer"
designer_source_text = designer_source.read_text() if designer_source.is_file() else ""
designer_text = designer_path.read_text() if designer_path.is_file() else ""
check(designer_source.is_file(), f"canonical frontend designer exists at {designer_source}")
check("\nmodel: fable\n" in designer_source_text, "canonical frontend designer selects Fable")
check(
    designer_path.is_file() and designer_text == designer_source_text,
    f"{designer_path} matches the canonical Fable designer definition",
)
check(
    designer_owner_path.is_file()
    and designer_owner_path.read_text() == "agent-lb:frontend-designer:v1\n",
    f"{designer_owner_path} records installer ownership",
)

planner_source = REPO / "config" / "coding-agents" / "agents" / "planner.md"
planner_path = HOME / ".claude" / "agents" / "planner.md"
planner_owner_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "planner"
planner_source_text = planner_source.read_text() if planner_source.is_file() else ""
planner_text = planner_path.read_text() if planner_path.is_file() else ""
check(planner_source.is_file(), f"canonical planner exists at {planner_source}")
check("\nmodel: claude-planner\n" in planner_source_text, "canonical planner selects the planner route alias")
check("\neffort: high\n" in planner_source_text, "canonical planner pins high effort")
check(
    planner_path.is_file() and planner_text == planner_source_text,
    f"{planner_path} matches the canonical Fable-primary planner definition",
)
check(
    planner_owner_path.is_file() and planner_owner_path.read_text() == "agent-lb:planner:v1\n",
    f"{planner_owner_path} records installer ownership",
)

reviewer_source = REPO / "config" / "coding-agents" / "agents" / "plan-reviewer.md"
reviewer_path = HOME / ".claude" / "agents" / "plan-reviewer.md"
reviewer_owner_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "plan-reviewer"
reviewer_source_text = reviewer_source.read_text() if reviewer_source.is_file() else ""
reviewer_text = reviewer_path.read_text() if reviewer_path.is_file() else ""
check(reviewer_source.is_file(), f"canonical plan reviewer exists at {reviewer_source}")
check(
    "\nmodel: claude-planner\n" in reviewer_source_text,
    "canonical plan reviewer selects the planner route alias",
)
check("\neffort: high\n" in reviewer_source_text, "canonical plan reviewer pins high effort")
check(
    "disallowedTools: [Write, Edit]" in reviewer_source_text,
    "canonical plan reviewer cannot write",
)
check(
    reviewer_path.is_file() and reviewer_text == reviewer_source_text,
    f"{reviewer_path} matches the canonical Fable-primary plan reviewer definition",
)
check(
    reviewer_owner_path.is_file()
    and reviewer_owner_path.read_text() == "agent-lb:plan-reviewer:v1\n",
    f"{reviewer_owner_path} records installer ownership",
)

fable_client = REPO / "clients" / "fable"
fable_text = fable_client.read_text() if fable_client.is_file() else ""
check(os.access(fable_client, os.X_OK), f"{fable_client} is executable")
check(
    'DEFAULT_DRIVER_MODEL = "claude-fable-5[1m]"' in fable_text,
    "fable driver mode targets claude-fable-5[1m]",
)
for slot in ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_FABLE_MODEL"):
    check(f'"{slot}"' in fable_text, f"fable driver mode swaps {slot}")
for slot in (
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "CLAUDE_CODE_SUBAGENT_MODEL",
):
    check(
        f'os.environ[{slot!r}]' not in fable_text and f'os.environ["{slot}"] =' not in fable_text,
        f"fable driver mode leaves {slot} to the canonical seats",
    )
check(
    'launcher = Path(__file__).resolve().with_name("claude-lb-launch")' in fable_text,
    "fable driver mode runs through the canonical launcher",
)
installer_text = (REPO / "scripts" / "install-claude-clients.sh").read_text()
check("CLIENT_NAMES=(cc fable opus)" in installer_text, "client installer installs cc, fable, and opus")

# The canon states the RULE; which seat serves which class lives in the routing
# table, and is checked there (router program, 2026-09-19). A seat/model table
# in the canon would be a second copy free to go stale, so its absence is the
# check.
routing_text = CANONICAL.read_text() if CANONICAL.is_file() else ""
for phrase in (
    "Fable is the driver and the judge",
    "Opus 5 is the default seat, and it is not rationed",
    "Verification is cross-vendor",
    "config/coding-agents/routing-table.json",
    "route pick",
):
    check(phrase in routing_text, f"canonical policy states: {phrase}")
check(
    not [line for line in routing_text.splitlines() if "| Driver (main loop)" in line],
    "canonical policy does not duplicate the routing table",
)

table_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "routing-table.json"
table = json.loads(table_path.read_text()) if table_path.is_file() else {"classes": {}}
for task_class, seat, model in (
    ("explore", "Explore", "claude-sonnet-5"),
    ("implement", "opus-seat", "claude-opus-5"),
    ("mechanical", "cursor-seat", "cursor-grok-4.6-medium-fast"),
    ("verify", "codex-verifier", "gpt-5.6-sol-xhigh"),
):
    chain = (table.get("classes", {}).get(task_class) or {}).get("chain") or []
    check(
        any(entry.get("seat") == seat and entry.get("model") == model for entry in chain),
        f"routing table routes {task_class} to {seat} on {model}",
    )
check(
    (table.get("classes", {}).get("verify") or {}).get("cross_vendor") is True,
    "routing table marks verify cross-vendor",
)

launcher_text = (REPO / "clients" / "claude-lb-launch").read_text()
check('CCGPT_MODEL = "gpt-5.6-sol"' in launcher_text, "CCDEX compatibility model remains gpt-5.6-sol")
check(
    'command.extend(["--model", CCGPT_MODEL, "--effort", "high"])' in launcher_text,
    "CCDEX compatibility effort remains high",
)

owned_registrations = [
    (event, group.get("matcher", ""))
    for event, groups in settings.get("hooks", {}).items()
    for group in groups
    for hook_config in group.get("hooks", [])
    if "ccdex-gpt-only.sh" in hook_config.get("command", "")
]
check(not owned_registrations, "no retired CCDEX hook registrations remain in settings")
check(not (HOME / ".claude" / "hooks" / "ccdex-gpt-only.sh").exists(), "retired CCDEX hook file is absent")

pytest_bin = REPO / ".venv" / "bin" / "pytest"
if pytest_bin.is_file():
    launcher_test = subprocess.run(
        [
            str(pytest_bin),
            "-q",
            "tests/unit/test_claude_lb_launch.py",
            "tests/unit/test_install_claude_clients.py",
        ],
        cwd=REPO,
        text=True,
        capture_output=True,
        timeout=120,
    )
    check(launcher_test.returncode == 0, "launcher and installer routing tests pass")
    if launcher_test.returncode:
        print(launcher_test.stdout[-2000:])
        print(launcher_test.stderr[-2000:], file=sys.stderr)
else:
    check(False, f"routing test runner exists at {pytest_bin}")

bin_dir = HOME / ".local" / "bin"
cc_target = bin_dir / "cc"
check(
    cc_target.is_symlink() and cc_target.resolve() == (REPO / "clients" / "cc").resolve(),
    "cc resolves to the repository client",
)
for name in ("ccdex", "ccdex-worker-mcp"):
    check(not (bin_dir / name).exists(), f"retired client {name} is absent from {bin_dir}")

policy_link = HOME / ".agents" / "policy" / "coding-agents"
check(
    policy_link.is_symlink() and policy_link.resolve() == (REPO / "config" / "coding-agents").resolve(),
    "policy link resolves to the repository policy",
)

claude_bin = os.environ.get("AGENT_LB_CLAUDE_BIN")
if not claude_bin:
    local_claude = HOME / ".local" / "bin" / "claude"
    claude_bin = str(local_claude) if local_claude.is_file() else "claude"
try:
    mcp = subprocess.run(
        [claude_bin, "mcp", "get", "ccdex-worker"],
        text=True,
        capture_output=True,
        timeout=30,
    )
except FileNotFoundError:
    check(False, f"Claude Code executable exists at {claude_bin}")
else:
    check(mcp.returncode != 0, "retired ccdex-worker MCP is not registered")

if failures:
    print(f"\n{len(failures)} routing check(s) failed", file=sys.stderr)
    raise SystemExit(1)
print("\nAll deterministic coding-agent routing checks passed.")
